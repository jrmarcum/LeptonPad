{
  "version": "2.2.1",
  "nodeModulesDir": "none",
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext", "deno.ns"]
  },
  "imports": {
    "solver": "./src/solver.ts",
    "@clerk/clerk-js/headless": "npm:@clerk/clerk-js@^5/headless"
  },
  "tasks": {
    "build:wasm": "deno run -A jsr:@jrmarcum/wasmtk modc solver/solver.ts -n dist/solver.wasm",
    "sync:version": "deno run -A scripts/sync-version.ts",
    "build": "deno task sync:version && deno task build:wasm && deno run -A build.ts",
    "dev": "deno task sync:version && deno task build:wasm && deno run -A --env-file=.env.api dev.ts",
    "api:dev": "deno run --allow-net --allow-env --env-file=.env.api --watch api/main.ts",
    "db:check": "deno run --allow-net --allow-env --env-file=.env.api db/check.ts",
    "promote": "deno run --allow-net --allow-env --env-file=.env.api db/promote.ts",
    "check": "deno fmt && deno lint",
    "serve": "deno run -A serve.ts",
    "serve:prod": "deno run --allow-net --allow-read main.ts",
    "install": "deno task build && deno install --config deno.json -g -f -n leptonpad --allow-net --allow-read --allow-write --allow-run $(pwd)/serve.ts",
    "compile": "deno compile --allow-net --allow-read --allow-write --allow-run --no-terminal --output leptonpad serve.ts"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": true,
    "proseWrap": "preserve",
    "exclude": ["dist/"]
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["dist/"]
  }
}
