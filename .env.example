# LeptonPad — browser configuration.
# Copy to .env and fill in, then run `deno task dev`.
#
# Everything here is PUBLIC — it is written into dist/config.js and ships to
# every browser. Publishable keys only.
#
# Server-side secrets (DATABASE_URL, CLERK_SECRET_KEY) belong in .env.api for
# local work and in the Deno Deploy dashboard for production. Never here.

# Clerk — identity. Dashboard → API Keys → Publishable key.
CLERK_PUBLISHABLE_KEY=pk_test_your-clerk-publishable-key

# Where the entitlement API lives.
#
# LEAVE UNSET almost always. Both dev.ts (:5173) and main.ts mount the API at
# /api on their own origin, and write-config.ts defaults to "/api" — so dev and
# production behave identically with no value here.
#
# Only set it to target a separately-running `deno task api:dev`:
# LP_API_URL=http://localhost:8000
