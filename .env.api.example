# LeptonPad API (api/main.ts) — TEMPLATE ONLY. This file is COMMITTED TO GIT.
#
# ⚠️ Never put a real value in this file. Copy it to .env.api (gitignored) and
# fill that in instead:
#
#     cp .env.api.example .env.api
#
# Three places these values live, and only one of them is this file:
#   .env.api.example  → this template, committed, placeholders only
#   .env.api          → your machine, gitignored, real values for `deno task api:dev`
#   Deno Deploy env   → production, set in the dashboard, never in a file
#
# Nothing here may reach the browser bundle. The client gets only what is in
# .env — the Clerk publishable key and the API URL.

# Neon connection string — Neon Console → your project → Connection Details.
# The pooled endpoint is fine and is what the serverless driver expects.
# Keep the full ?sslmode=require suffix; a truncated value fails to connect.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk PEM public key — Clerk Dashboard → API Keys → "JWT public key" (PEM).
# This is the PUBLIC half; it enables networkless JWT verification, so the API
# makes no outbound call per request. Do NOT paste the secret key here.
CLERK_JWT_KEY="-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"

# Only used if CLERK_JWT_KEY is unset — verification then fetches JWKS per cold
# start. This one IS a secret.
CLERK_SECRET_KEY=

# Exact origins allowed to call this API, comma-separated. No wildcards, no
# trailing slashes. Include your dev origin or local browser calls fail CORS.
ALLOWED_ORIGINS=http://localhost:5173,https://leptonpad.vercel.app
